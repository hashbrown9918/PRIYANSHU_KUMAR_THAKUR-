<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Priyanshu's portfolio: data science student at IIT Madras and beginner web developer.">
    <title>Priyanshu | Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Newsreader:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <style>
        :root {
            --paper: #f5f7f2;
            --grid: #d3deea;
            --ink: #14213d;
            --muted: #4f5b72;
            --margin: #e4572e;
            --mark: #ffd84d;
            --card: #ffffff;
            --display: "Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
            --body: "Newsreader", Georgia, serif;
        }

        :root[data-theme="dark"] {
            --paper: #0f1a2e;
            --grid: #1d2c47;
            --ink: #eef2f8;
            --muted: #a3b0c6;
            --margin: #ff7a55;
            --mark: #8a6d00;
            --card: #172641;
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            font-family: var(--body);
            font-size: 1.15rem;
            line-height: 1.75;
            color: var(--ink);
            background-color: var(--paper);
            background-image:
                linear-gradient(var(--grid) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid) 1px, transparent 1px);
            background-size: 32px 32px;
        }

        /* notebook margin line */
        body::before {
            content: "";
            position: fixed;
            top: 0; bottom: 0;
            left: clamp(12px, 6vw, 80px);
            width: 2px;
            background: var(--margin);
            opacity: 0.7;
            pointer-events: none;
        }

        a { color: inherit; }
        :focus-visible { outline: 3px solid var(--margin); outline-offset: 3px; }

        .wrap {
            max-width: 860px;
            margin: 0 auto;
            padding: 0 1.25rem 0 clamp(36px, 10vw, 120px);
        }

        /* top bar */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            padding: 1.25rem 0;
            font-family: var(--display);
            font-weight: 500;
            font-size: 1rem;
        }
        nav ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
        nav a { text-decoration: none; }
        nav a:hover { text-decoration: underline wavy var(--margin); text-underline-offset: 5px; }

        #theme {
            font: inherit;
            cursor: pointer;
            padding: 0.3rem 0.8rem;
            color: var(--ink);
            background: var(--card);
            border: 2px solid var(--ink);
            border-radius: 999px;
        }

        /* hero */
        .hero { padding: 4rem 0 3rem; }
        .hero h1 {
            margin: 0;
            font-family: var(--display);
            font-weight: 800;
            font-size: clamp(3.2rem, 14vw, 8rem);
            line-height: 0.95;
            letter-spacing: -0.04em;
        }
        .hero h1 span {
            background: linear-gradient(var(--mark), var(--mark)) no-repeat 0 88% / 0% 0.38em;
            animation: draw 0.9s 0.3s ease-out forwards;
        }
        @keyframes draw { to { background-size: 100% 0.38em; } }

        .hero p.lead {
            margin: 1.5rem 0 0;
            max-width: 34ch;
            font-size: clamp(1.3rem, 3vw, 1.7rem);
            line-height: 1.4;
        }
        #typed { border-right: 2px solid var(--ink); padding-right: 2px; }

        /* sections */
        section { padding: 2.5rem 0; }
        h2 {
            margin: 0 0 1.25rem;
            font-family: var(--display);
            font-weight: 700;
            font-size: 1.9rem;
            letter-spacing: -0.02em;
        }
        p { margin: 0 0 1rem; max-width: 62ch; }

        /* about */
        .about::after { content: ""; display: block; clear: both; }
        .photo {
            float: right;
            width: 210px;
            margin: 0 0 1rem 1.75rem;
            padding: 10px 10px 34px;
            background: #fff;
            box-shadow: 0 6px 18px rgba(20, 33, 61, 0.28);
            transform: rotate(3deg);
        }
        .photo img { display: block; width: 100%; height: 250px; object-fit: cover; background: var(--grid); }
        .photo figcaption {
            margin-top: 8px;
            text-align: center;
            font-family: var(--display);
            font-size: 0.85rem;
            color: #14213d;
        }

        /* learning chips */
        .chips { display: flex; flex-wrap: wrap; gap: 0.6rem; list-style: none; margin: 0 0 1.25rem; padding: 0; }
        .chips li {
            padding: 0.25rem 1rem;
            font-family: var(--display);
            font-weight: 500;
            background: var(--card);
            border: 2px solid var(--ink);
            border-radius: 999px;
        }
        .chips.soft li { border-color: var(--grid); font-weight: 400; }
        .sub { font-family: var(--display); font-weight: 500; margin: 1.25rem 0 0.6rem; font-size: 1rem; color: var(--muted); }

        /* education timeline */
        .timeline { list-style: none; margin: 0; padding: 0 0 0 1.5rem; border-left: 3px solid var(--ink); }
        .timeline li { position: relative; margin-bottom: 1.5rem; }
        .timeline li::before {
            content: "";
            position: absolute;
            left: calc(-1.5rem - 9px);
            top: 0.55rem;
            width: 15px; height: 15px;
            background: var(--paper);
            border: 3px solid var(--ink);
            border-radius: 50%;
        }
        .timeline li.now::before { background: var(--margin); border-color: var(--margin); }
        .timeline h3 { margin: 0; font-family: var(--display); font-size: 1.15rem; }
        .timeline .meta { margin: 0; color: var(--muted); }

        /* project card */
        .card {
            max-width: 62ch;
            padding: 1.5rem;
            background: var(--card);
            border: 2px solid var(--ink);
            box-shadow: 6px 6px 0 var(--ink);
        }
        .card h3 { margin: 0 0 0.5rem; font-family: var(--display); font-size: 1.3rem; }
        .card p:last-child { margin: 0; }

        /* hobbies */
        .hobbies { display: flex; flex-wrap: wrap; gap: 0.9rem; list-style: none; margin: 0; padding: 0; }
        .hobbies li {
            padding: 0.5rem 1.1rem;
            font-family: var(--display);
            font-weight: 500;
            background: var(--card);
            border: 2px dashed var(--muted);
            transition: transform 0.15s;
        }
        .hobbies li:nth-child(odd) { transform: rotate(-1.5deg); }
        .hobbies li:nth-child(even) { transform: rotate(1.5deg); }
        .hobbies li:hover { transform: rotate(0) scale(1.06); border-style: solid; border-color: var(--margin); }

        /* contact */
        .links { display: flex; flex-wrap: wrap; gap: 1rem; list-style: none; margin: 0; padding: 0; }
        .links a {
            display: inline-block;
            padding: 0.5rem 1.25rem;
            font-family: var(--display);
            font-weight: 700;
            text-decoration: none;
            color: #14213d;
            background: var(--mark);
            border: 2px solid var(--ink);
        }
        .links a:hover { background: var(--margin); color: #fff; }

        footer { padding: 2rem 0 3rem; font-family: var(--display); font-size: 0.9rem; color: var(--muted); }

        @media (max-width: 560px) {
            .photo { float: none; margin: 0 auto 1.5rem; }
        }
        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .hero h1 span { animation: none; background-size: 100% 0.38em; }
            .hobbies li { transition: none; }
        }
    </style>
</head>

<body>
    <div class="wrap">
        <nav>
            <ul>
                <li><a href="#about">About</a></li>
                <li><a href="#learning">Learning</a></li>
                <li><a href="#education">Education</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
            <button id="theme" type="button" aria-label="Switch between light and dark theme">Dark mode</button>
        </nav>

        <header class="hero">
            <h1><span>Priyanshu</span></h1>
            <p class="lead">I study data science and I'm <span id="typed" aria-live="polite">learning to build websites.</span></p>
        </header>

        <main>
            <section class="about" id="about">
                <h2>About me</h2>
                <figure class="photo">
                    <img src="images/priyanshu.jpg" alt="Portrait of Priyanshu">
                    <figcaption>Priyanshu</figcaption>
                </figure>
                <p>I am Priyanshu, a student pursuing a BS in Data Science and Applications at the Indian Institute of Technology (IIT) Madras.</p>
                <p>Alongside my degree, I am teaching myself HTML, CSS, and JavaScript. This is my first portfolio website, and I am looking forward to learning a lot more about web development.</p>
            </section>

            <section id="learning">
                <h2>What I'm learning</h2>
                <p class="sub">Web development</p>
                <ul class="chips">
                    <li>HTML</li>
                    <li>CSS</li>
                    <li>JavaScript</li>
                </ul>
                <p class="sub">At IIT Madras</p>
                <ul class="chips soft">
                    <li>Mathematics</li>
                    <li>Statistics</li>
                    <li>Computing</li>
                    <li>English</li>
                </ul>
            </section>

            <section id="education">
                <h2>Education</h2>
                <ul class="timeline">
                    <li class="now">
                        <h3>BS in Data Science and Applications</h3>
                        <p class="meta">IIT Madras (in progress)</p>
                    </li>
                    <li>
                        <h3>Class 12th: Sarvodaya Vidyalaya</h3>
                        <p class="meta">65%. Senior secondary in the PCM stream.</p>
                    </li>
                    <li>
                        <h3>Class 10th: Lions Vidya Mandir</h3>
                        <p class="meta">80%</p>
                    </li>
                </ul>
            </section>

            <section id="projects">
                <h2>Projects</h2>
                <article class="card">
                    <h3>This portfolio</h3>
                    <p>My first website, written by hand in HTML, CSS, and JavaScript. It includes a dark mode toggle and a layout that adapts to phones.</p>
                    <p>More projects will appear here as I build them.</p>
                </article>
            </section>

            <section id="hobbies">
                <h2>Outside of study</h2>
                <ul class="hobbies">
                    <li>Art and craft</li>
                    <li>Reading books</li>
                    <li>Athletics</li>
                    <li>Cooking</li>
                    <li>Travelling</li>
                </ul>
            </section>

            <section id="contact">
                <h2>Get in touch</h2>
                <ul class="links">
                    <!-- Replace each # with your real link -->
                    <li><a href="mailto:your-email@example.com">Email me</a></li>
                    <li><a href="https://github.com/your-username">GitHub</a></li>
                    <li><a href="https://www.linkedin.com/in/your-username">LinkedIn</a></li>
                </ul>
            </section>
        </main>

        <footer>&copy; 2026 Priyanshu</footer>
    </div>

    <script>
        // Theme toggle (remembers the choice when storage is available)
        var root = document.documentElement;
        var btn = document.getElementById("theme");

        function setTheme(mode) {
            root.setAttribute("data-theme", mode);
            btn.textContent = mode === "dark" ? "Light mode" : "Dark mode";
            try { localStorage.setItem("theme", mode); } catch (e) {}
        }

        var saved = null;
        try { saved = localStorage.getItem("theme"); } catch (e) {}
        if (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches) saved = "dark";
        if (saved) setTheme(saved);

        btn.addEventListener("click", function () {
            setTheme(root.getAttribute("data-theme") === "dark" ? "light" : "dark");
        });

        // Typing effect for the hero line (skipped if the visitor prefers less motion)
        var phrases = [
            "learning to build websites.",
            "learning HTML, CSS, and JavaScript.",
            "working through statistics and maths."
        ];
        var el = document.getElementById("typed");
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (!reduce) {
            var p = 0, i = phrases[0].length, deleting = true;
            (function tick() {
                var text = phrases[p];
                if (deleting) { i--; } else { i++; }
                el.textContent = text.slice(0, i);
                var delay = deleting ? 35 : 70;
                if (!deleting && i === text.length) { delay = 2200; deleting = true; }
                else if (deleting && i === 0) { deleting = false; p = (p + 1) % phrases.length; text = phrases[p]; delay = 400; }
                setTimeout(tick, delay);
            })();
        }
    </script>
</body>

</html>